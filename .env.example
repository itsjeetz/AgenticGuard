# =============================================================================
# AgenticGuard Environment Variables Template
# Copy this file to .env and configure your desired providers and settings.
# =============================================================================

# LLM Judge Provider Priority Order
# 1. Gemini Key 1 -> 2. Gemini Key 2 -> 3. Groq (groq.com) -> 4. Rules-Only Fallback
LLM_PROVIDER_ORDER=gemini_1,gemini_2,groq

# Rate limiting for LLM judge calls (sliding window per-minute limit)
LLM_RATE_LIMIT_PER_MINUTE=30

# -----------------------------------------------------------------------------
# 1. Google Gemini (OpenAI-compatible /chat/completions endpoint)
# Primary semantic evaluation engine
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# 2. Groq (OpenAI-compatible endpoint at https://api.groq.com/openai/v1)
# High-throughput second line of defense (groq.com, NOT xAI Grok)
# -----------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# -----------------------------------------------------------------------------
# Server and Observability Configuration
# -----------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
STORE_CONTENT=0
