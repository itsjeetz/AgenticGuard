# =============================================================================
# AgenticGuard Environment Variables Template
# Copy this file to .env and configure your desired providers and settings.
# =============================================================================

# LLM Judge Provider Priority Order
# 1. Groq Key 1 (PRIMARY) -> 2. Groq Key 2 -> 3. Gemini Key 1 (backup) -> 4. Gemini Key 2 (backup) -> 5. Rules-Only Fallback
LLM_PROVIDER_ORDER=groq_1,groq_2,gemini_1,gemini_2

# Rate limiting for LLM judge calls (sliding window per-minute limit)
LLM_RATE_LIMIT_PER_MINUTE=30

# -----------------------------------------------------------------------------
# 1. Groq (OpenAI-compatible endpoint at https://api.groq.com/openai/v1)
# Primary and secondary high-speed evaluation engines (groq.com, NOT xAI Grok)
# -----------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# -----------------------------------------------------------------------------
# 2. Google Gemini (OpenAI-compatible /chat/completions endpoint)
# Backup semantic evaluation engines
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# Server and Observability Configuration
# -----------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
STORE_CONTENT=0
DAILY_LLM_CALLS_LIMIT=300

